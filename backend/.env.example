# anthropic | ollama
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:9b

# NCBI requires a contact email on every request
NCBI_EMAIL=
# optional: raises rate limit 3/sec -> 10/sec
NCBI_API_KEY=
# optional but recommended, higher rate limit
SEMANTIC_SCHOLAR_API_KEY=

SUPABASE_URL=
# server-side only, never exposed to frontend
SUPABASE_SERVICE_ROLE_KEY=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

RATE_LIMIT_PER_IP_PER_DAY=20
RATE_LIMIT_GLOBAL_PER_DAY=300
MAX_SUBTOPICS=4
MAX_CHUNKS_PER_SUBTOPIC=8
MAX_SYNTHESIS_OUTPUT_TOKENS=1800
MAX_QUESTION_LENGTH=500

# fastembed | voyage | openai (escape hatch)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

CORS_ALLOWED_ORIGINS=http://localhost:3000
ENVIRONMENT=development
